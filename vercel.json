{
  "buildCommand": "react-scripts build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/((?!static/|api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/check-github", "schedule": "29 18 * * *" }
  ]
}
